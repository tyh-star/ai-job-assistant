# Pipeline batch directories: exported JSONL and manifests from local runs.
# Collected job data, kept beside the project for inspection, never committed.
.pipeline-batches/

# Staged build artifacts for the Linux pipeline image (Go binary + version stamps).
# Rebuilt by infra/pipeline/build-pipeline-image.sh; never committed.
.pipeline-build/
