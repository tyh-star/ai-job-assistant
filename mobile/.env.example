# Copy to .env.local (git-ignored) and pick ONE.
#
# Leave unset during `npx expo start`: Expo Go then calls the Spring Boot backend on
# the computer running Metro, at http://<that computer's LAN IP>:8080/api/v1.
#
# Explicit LAN address (phone and computer on the same Wi-Fi):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8080
#
# Deployed site (Caddy proxies /api/v1 to the backend):
# EXPO_PUBLIC_API_BASE_URL=https://your-domain.example
