AIJOB_DB_URL=jdbc:mysql://localhost:3306/AIjob?useSSL=false&serverTimezone=UTC
AIJOB_DB_USERNAME=
AIJOB_DB_PASSWORD=
AIJOB_JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AIJOB_STORAGE_ROOT=uploads
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY_CODE=ca
JSEARCH_API_KEY=
JSEARCH_API_BASE_URL=https://api.openwebninja.com
JOB_SEARCH_PRIMARY_PROVIDER=JSEARCH
JSEARCH_MAX_PAGES_PER_SEARCH=10
AIJOB_TAILOR_ENGINE=V2

# --- /api/v1/job-catalog/** (the Jobs page's actual search/detail/save routes) ---
# freehire (default): every search/detail/save calls FreeHire's own hosted API.
# local_catalog: explicit opt-in to this deployment's own collected job_catalog table.
# Switching to local_catalog does NOT turn collection back on -- see JOB_COLLECTOR_ENABLED.
JOB_CATALOG_PROVIDER=freehire
# FREEHIRE_API_BASE_URL=https://freehire.me/api/v1   # default; override only for a test fixture
FREEHIRE_USER_AGENT=ai-job-assistant/1.0
FREEHIRE_CONNECT_TIMEOUT_SECONDS=5
FREEHIRE_READ_TIMEOUT_SECONDS=10
FREEHIRE_MAX_RESPONSE_BYTES=5242880
FREEHIRE_MAX_CONCURRENT_REQUESTS=5
# Per-minute request BUDGET, backend-wide (shared by all users) -- separate from the
# concurrency cap above. Process-local: only the effective global budget while
# production runs a single backend instance (true today); a multi-instance deployment
# must share this state (e.g. Redis) or divide the budget across instances.
# search: kept below FreeHire's own confirmed 300/min limit, on purpose.
FREEHIRE_SEARCH_RATE_LIMIT_PER_MINUTE=180
# read (GET /jobs/{slug}): FreeHire has not published a number for this endpoint;
# this default is a conservative, UNCONFIRMED guess, not a documented limit.
FREEHIRE_READ_RATE_LIMIT_PER_MINUTE=120
