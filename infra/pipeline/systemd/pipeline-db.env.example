# /etc/aijob/pipeline-db.env -- the database connection for the scheduled pipeline.
#
#   sudo install -o root -g aijob -m 0640 pipeline-db.env.example /etc/aijob/pipeline-db.env
#   sudo -e /etc/aijob/pipeline-db.env
#
# THIS IS NOT infra/mysql-test/.env.mysql-test. That file points at a throwaway container
# on loopback holding synthetic postings, and its account has ALL PRIVILEGES on a scratch
# schema. Pointing the scheduled pipeline at it would collect into a database that gets
# truncated by the test suite; pointing it at production with those credentials would
# hand a collector an account that can drop tables. Two files, two accounts, on purpose.
#
# Mode 0640, owned root:aijob. The service reads it; nobody else needs to.

SPRING_DATASOURCE_URL=jdbc:mysql://DB_HOST:3306/DB_NAME?useSSL=true&requireSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=aijob_collector
SPRING_DATASOURCE_PASSWORD=

# The collector profile has no HTTP surface and never issues a token or calls a model.
# Its placeholders come from application-collector.yml; no real key belongs in this file.
JOB_COLLECTOR_ENABLED=false

# Which boards may be collected. The importer re-reads this for itself.
AIJOB_COLLECTOR_ALLOWLIST_FILE=/opt/aijob/config/sources-allowlist.json

# ---------------------------------------------------------------------------
# DATABASE PRIVILEGES
# ---------------------------------------------------------------------------
# Two accounts, because migrating and collecting are different jobs with different blast
# radii. A collector that can ALTER can also, with one bad statement, change a column the
# whole catalog depends on -- and it runs unattended every six hours.
#
# NOT CREATED HERE. These are the statements to review and run by hand against the
# database you intend to use; nothing in this repository creates a production account.
#
# 1. The collection account -- what the scheduled pipeline uses.
#    Reads and writes catalog rows. It cannot change the shape of anything.
#
#      CREATE USER 'aijob_collector'@'%' IDENTIFIED BY '<generated>';
#      GRANT SELECT, INSERT, UPDATE, DELETE ON `aijob`.`job_sources`            TO 'aijob_collector'@'%';
#      GRANT SELECT, INSERT, UPDATE, DELETE ON `aijob`.`job_catalog`            TO 'aijob_collector'@'%';
#      GRANT SELECT, INSERT, UPDATE, DELETE ON `aijob`.`job_source_records`     TO 'aijob_collector'@'%';
#      GRANT SELECT, INSERT, UPDATE         ON `aijob`.`job_ingest_runs`        TO 'aijob_collector'@'%';
#      GRANT SELECT                         ON `aijob`.`schema_migrations`      TO 'aijob_collector'@'%';
#
#    Deliberately absent:
#      * CREATE / ALTER / DROP / INDEX / REFERENCES -- migration privileges, below
#      * any grant on users, resumes, jobs, tailor_proposals -- the collector has no
#        business reading a résumé or a personal job, and an account that cannot is one
#        that cannot leak them
#      * DELETE on job_ingest_runs -- run history is the audit trail
#      * anything ON *.* beyond USAGE
#
#    Note the DELETE grants on the three catalog tables: the importer never deletes, but
#    a housekeeping path in the same codebase purges expired rows, and a grant that has
#    to be added under pressure later is worse than one scoped now. If you would rather
#    it could not delete at all, drop DELETE and the import still works.
#
# 2. The migration account -- used by hand, during a release, and never by the timer.
#
#      CREATE USER 'aijob_migrator'@'%' IDENTIFIED BY '<generated>';
#      GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX, REFERENCES, DROP
#        ON `aijob`.* TO 'aijob_migrator'@'%';
#
#    Its password does not belong in this file, or in any file the timer reads.
#
# Neither account needs FILE, PROCESS, SUPER, RELOAD or CREATE USER. If a grant looks
# necessary and is not listed, that is worth understanding before adding it.
