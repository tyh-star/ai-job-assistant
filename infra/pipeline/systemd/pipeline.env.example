# /etc/aijob/pipeline.env -- non-secret settings for the scheduled pipeline.
#
# Copy to /etc/aijob/pipeline.env. Nothing in this file is a credential; the database
# connection lives in pipeline-db.env beside it, which is the file with restrictive
# permissions. Keeping them apart means this one can be read, diffed and version-tracked
# without exposing anything.

# The image built by infra/pipeline/build-pipeline-image.sh. Pin a digest in production:
# a tag can be repointed, and then a "known" deployment is running something else.
#   AIJOB_PIPELINE_IMAGE=aijob-pipeline@sha256:<digest>
AIJOB_PIPELINE_IMAGE=aijob-pipeline:local

# Docker network that can reach the database host by name.
AIJOB_DOCKER_NETWORK=aijob-net

# Named volume holding batches, per-board state and the lock. It must be the SAME volume
# for every container that can run this: the flock and the back-off state are both
# per-filesystem, and a private volume gives each container its own "the" lock.
AIJOB_STATE_VOLUME=aijob-pipeline-state

# Refuse to run unless the image was built from this exporter commit. Leave empty to
# accept whatever the image carries (it is recorded either way).
AIJOB_EXPECTED_EXPORTER_SHA=

# --- collection shape -------------------------------------------------------
# Per board, per run. Deliberately small: this is a sample-import pipeline, and a larger
# cap does not make a batch a complete snapshot.
AIJOB_MAX_PER_BOARD=50

# Seconds between one board and the next within a run. Not applied before the first.
AIJOB_BOARD_INTERVAL_SECONDS=30

# --- retention --------------------------------------------------------------
AIJOB_KEEP_SUCCESS_DAYS=14
AIJOB_KEEP_FAILED_DAYS=30
AIJOB_KEEP_SUMMARY_DAYS=90
