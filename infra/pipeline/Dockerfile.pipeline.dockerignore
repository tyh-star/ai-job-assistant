# Build context for Dockerfile.pipeline only. BuildKit prefers this over the root
# .dockerignore, which excludes src/test (fine here, the image ships a jar) but does not
# know about .pipeline-build/, which this build needs.
.git
.gitattributes
.idea
.vscode
.deploy
target
uploads
docs
frontend
src/test
# Collected job postings from local runs: real third-party content, never in a layer.
.pipeline-batches
# Credentials, at any depth. `.env.*` alone would not match infra/mysql-test/.env.mysql-test.
**/.env
**/.env.*
!.env.example
infra/aws/.env.aws
infra/mysql-test/.env.mysql-test
infra/aws/releases
**/*.iml
**/.DS_Store
regression-test-output.docx
db-backups
