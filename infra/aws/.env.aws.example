# Copy to infra/aws/.env.aws on the server. Never commit real values.
# .env.aws is gitignored.

# Public hostname for Caddy HTTPS, for example:
#   203.0.113.10.sslip.io
PUBLIC_HOST=
CADDY_ACME_EMAIL=

MYSQL_DATABASE=aijob
MYSQL_USER=aijob
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

AIJOB_DB_URL=jdbc:mysql://mysql:3306/aijob?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
AIJOB_DB_USERNAME=aijob
AIJOB_DB_PASSWORD=
AIJOB_JWT_SECRET=
AIJOB_JWT_EXPIRATION=86400000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Resume Rewrite (简历改写) via Groq. Keep the key only in .env.aws on the server.
GROQ_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_FREE_MODEL=openai/gpt-oss-20b
AI_PRO_MODEL=openai/gpt-oss-120b

# LOCAL_CATALOG serves user search from the self-hosted job_catalog table and never
# makes an outbound job-search call. JSEARCH is kept only as a rollback value; the
# JSearch beans are not created at all while LOCAL_CATALOG is selected, so the key
# below may stay empty.
# The Jobs page on this site calls FreeHire. Keep this freehire unless you have
# deliberately switched the deployment to the self-hosted collector catalog.
JOB_CATALOG_PROVIDER=freehire
JOB_SEARCH_PRIMARY_PROVIDER=LOCAL_CATALOG
JSEARCH_API_KEY=
JSEARCH_API_BASE_URL=https://api.openwebninja.com
JSEARCH_MAX_PAGES_PER_SEARCH=10

# Background ATS collection (collector container). Collection stays off until this is
# explicitly set to true, and only job_sources rows with enabled=1 AND crawl_allowed=1
# are ever fetched. See docs/job-catalog.md before enabling.
JOB_COLLECTOR_ENABLED=false
JOB_COLLECTOR_INTERVAL_MINUTES=120
JOB_COLLECTOR_INITIAL_DELAY_MINUTES=1
JOB_COLLECTOR_MAX_CONCURRENCY=2
JOB_COLLECTOR_BATCH_SIZE=100
JOB_EXPIRY_GRACE_HOURS=72
# Boards see this User-Agent; put a real mailbox here so operators can be contacted.
JOB_COLLECTOR_USER_AGENT=AiJobAssistantCollector/1.0
JOB_COLLECTOR_CONTACT_EMAIL=
JOB_COLLECTOR_REQUEST_TIMEOUT_SECONDS=20
JOB_COLLECTOR_MAX_RETRIES=3
JOB_COLLECTOR_MAX_JOBS_PER_SOURCE=2000
JOB_COLLECTOR_MAX_DESCRIPTION_CHARS=100000
JOB_COLLECTOR_MAX_RAW_PAYLOAD_CHARS=200000
JOB_COLLECTOR_RAW_PAYLOAD_RETENTION_DAYS=30
JOB_COLLECTOR_RUN_HISTORY_RETENTION_DAYS=30
# Cross-process collection lease. Raise it only if a board legitimately takes longer
# than this to read; lowering it below a real run length would let two processes
# collect the same board at once.
JOB_COLLECTOR_LOCK_TIMEOUT_MINUTES=60
# Keep the collector's share of MySQL connections small; the API needs the rest.
JOB_COLLECTOR_DB_POOL_MAX=3

AIJOB_STORAGE_ROOT=/data/uploads
AIJOB_TAILOR_ENGINE=V3
PDF_EXPORT_SOFFICE_PATH=/usr/bin/soffice
PDF_EXPORT_TIMEOUT_SECONDS=60

# Public HTTPS origin including the scheme. Comma-separate multiple origins.
# Example only; do not commit the real Elastic IP.
AIJOB_CORS_ALLOWED_ORIGINS=https://203.0.113.10.sslip.io
SERVER_FORWARD_HEADERS_STRATEGY=framework
